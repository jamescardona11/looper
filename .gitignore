# Looper — generated project gitignore

# Dependencies
node_modules
**/__pycache__/
.pnp
.pnp.js
.pnpm-store

# Build outputs
dist
build
.turbo
.next
.nuxt
.output

# Local
.env
.env.local
.env.*.local

# Tauri
# Rust build output, wherever a crate or workspace puts it.
**/target/
apps/desktop/src-tauri/gen

# Flutter / Dart generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
**/doc/api/
**/ios/Pods/
**/ios/.symlinks/
**/ios/DerivedData/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/android/.gradle/
**/android/captures/
**/android/.cxx/
**/android/local.properties

# Tests
coverage
playwright-report
playwright/.cache
test-results
test-results-*/
.playwright-cli/

# Editor
.vscode/!(extensions.json)
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Agent metadata (subagent evidence/learnings)
.tcompound/
**/ai_docs/
/corpus-inventory.csv
/corpus-summary.json
/docs/
!/docs/
!/docs/rebuild/
!/docs/rebuild/**

# Product artwork/assets stay local and are never part of reconstruction commits.
apps/desktop/assets/
apps/desktop/public/fonts/
apps/desktop/src-tauri/icons/
apps/desktop/src-tauri/macos/*.png
apps/mobile/assets/
apps/mobile/targets/**/Assets.xcassets/
apps/web/public/shots/
assets/brand/
/tact-design/

# Local audio model/test artifacts; source and manifests remain auditable.
packages/rust/audio/**/data/models/
packages/rust/audio/**/data/snapshots/
packages/rust/audio/**/data/inputs/
packages/rust/audio/**/data/outputs/*
!packages/rust/audio/**/data/outputs/.gitkeep

# Worktrunk worktree container — per-machine worktrees, never tracked.
.claude/worktrees/

# AI agent skills
.agent
.agents/*
!.agents/
!.agents/README.md
!.agents/skills/
!.agents/skills/**
.agents/**/.DS_Store
.augment
.claude/skills/
.claude/settings.local.json
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf
.vercel
.env*.local

# Agent tooling is local. The Tact design contract is versioned with the product.
.agents/

# Per-tool agent rules; the project copy lives in .claude/rules/.
.codex/rules/
