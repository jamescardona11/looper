# Copy to .env. Everything below except VITE_CONVEX_URL is read at COMPILE time
# by src-tauri/build.rs and baked into the binary with option_env!, so changing
# a value here requires a rebuild to take effect.

# Convex backend URL (required by the web layer).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Checkout and customer portal destinations (optional).
# VITE_LOOPER_PERSONAL_CHECKOUT_URL=https://buy.example.com/personal
# VITE_LOOPER_COMMERCIAL_CHECKOUT_URL=https://buy.example.com/commercial
# VITE_LOOPER_CUSTOMER_PORTAL=https://billing.example.com/portal


# Speech model mirror (required to install any local speech model).
#
# Looper downloads models from this base URL only. It deliberately does NOT fall
# back to HuggingFace or any other third-party host, and it verifies the sha256
# of every downloaded file against src-tauri/src/speech/catalog.rs.
#
# Without it, `looper models install <id>` fails with:
#   "LOOPER_MODEL_MIRROR_BASE_URL is not configured."
# and the app cannot transcribe anything, because no model can be installed.
#
# Files are fetched as {LOOPER_MODEL_MIRROR_BASE_URL}/{mirror_path}, e.g.
#   speech/parakeet-tdt-0.6b-v3-onnx/<rev>/encoder-model.int8.onnx
#
# Unlike the rest of this file, this one is ALSO read at runtime and the runtime
# value wins, so a one-off install needs no rebuild:
#   LOOPER_MODEL_MIRROR_BASE_URL=https://your-mirror looper models install parakeet_tdt_int8
# LOOPER_MODEL_MIRROR_BASE_URL=https://your-mirror


# PostHog analytics (optional). Both must be set or analytics stays disabled.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com


# Licensing via Polar (optional).
#
# Debug builds bypass the license gate entirely. Set this to exactly "1" to
# exercise the real gate in a debug build.
# LOOPER_FORCE_LICENSE_GATE=1

# Defaults to https://api.polar.sh when unset.
# LOOPER_POLAR_API_BASE=https://api.polar.sh
# LOOPER_POLAR_ORGANIZATION_ID=

# Polar's benefit_id is the source of truth for which edition a license grants.
# LOOPER_POLAR_BENEFIT_PERSONAL=
# LOOPER_POLAR_BENEFIT_COMMERCIAL=
# LOOPER_POLAR_BENEFIT_FOUNDER=
# LOOPER_POLAR_BENEFIT_CONTRIBUTOR=
