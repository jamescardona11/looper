# Copy this file to .env.local. Use the cloud deployment URL below or
# http://localhost:3210 when running Convex locally.
VITE_CONVEX_URL=https://your-deployment.convex.cloud


# PostHog analytics + feature flags (optional)
# Get from: https://us.posthog.com → Project Settings → Project API Key
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Stripe Price IDs (public identifiers only)
# VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_...
# VITE_STRIPE_ULTRA_MONTHLY_PRICE_ID=price_...
# VITE_STRIPE_ULTRA_YEARLY_PRICE_ID=price_...
# VITE_STRIPE_CREDITS_100_PRICE_ID=price_...
# VITE_STRIPE_CREDITS_500_PRICE_ID=price_...
# VITE_STRIPE_LIFETIME_PRICE_ID=price_...
