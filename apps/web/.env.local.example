# Local Convex override (OPT-IN — copy to .env.local only when running a
# LOCAL Convex backend). Vite loads .env.local over .env automatically, so
# this overrides the remote URL in .env. Delete .env.local to go back to
# remote/cloud (the default).
#
# Run a local backend with:  cd backend && npx convex dev  (while logged OUT
# of a Convex account → anonymous local deployment on :3210), or reconfigure
# with: npx convex dev --configure
VITE_CONVEX_URL=http://localhost:3210
