# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=local:local-looper

CONVEX_URL=http://127.0.0.1:3210

CONVEX_SITE_URL=http://127.0.0.1:3211

# agents module
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_MODEL=
BYOK_ENCRYPTION_SECRET=
# openai, assemblyai, deepgram, or elevenlabs
STT_PROVIDER=

# auth module
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
RESEND_API_KEY=

# billing module
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ULTRA_MONTHLY_PRICE_ID=
STRIPE_ULTRA_YEARLY_PRICE_ID=
STRIPE_CREDITS_100_PRICE_ID=
STRIPE_CREDITS_500_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
